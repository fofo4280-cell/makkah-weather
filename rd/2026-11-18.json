هاط الشمالية جنوب المدينة | متوسطة | هواء رطب يصعد الحرة", " | غرب الحسو | خفيفة | تدفعها رياح الطبقات المتوسطة من حرة رهاط الشمالية جنوب المدينة", "عسير | أبها والسودة ورجال ألمع | متوسطة | هواء البحر الرطب يصعد الحافة", " | النماص وتنومة وبللسمر | متوسطة | هواء البحر الرطب يصعد الحافة", " | محايل والدرب والبرك | خفيفة | هواء السحب البارد ينحدر مساءً من الجبال", "جازان | فيفاء وبني مالك والعيدابي | متوسطة | هواء البحر الرطب يصعد الحافة", " | صبيا وأبو عريش وصامطة | خفيفة | هواء السحب البارد ينحدر مساءً من الجبال", "الحدود الشمالية | قرب لينة | خفيفة | التقاء رياح جنوبية غربية برياح جنوبية", "فرصة على السهول: محايل والدرب والبرك (عسير)، وصبيا وأبو عريش وصامطة (جازان)، إذا نزل هواء السحب البارد من الجبال مساءً إلى الهواء الحار الرطب تحتها.", "وعلى تبوك، والجوف، وحائل رطوبة وتبريد علوي بلا التقاء رياح يحدد مكانًا، فالزخات هناك عابرة متفرقة.", "مكة المكرمة: تبريد علوي من أخدود ضحل، والرطوبة ١٣١٪ من معدلها، وطاقة عدم الاستقرار نحو ٥٦٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشمال الشرقي بنحو ٤ م/ث.", "الباحة: تبريد علوي من أخدود ضحل، والرطوبة ١٣٨٪ من معدلها، وطاقة عدم الاستقرار نحو ١٣١٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشمال الشرقي بنحو ٦ م/ث.", "المدينة المنورة: تبريد علوي من أخدود ضحل، والرطوبة ١٣١٪ من معدلها، وطاقة عدم الاستقرار نحو ٣١٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشمال الشرقي بنحو ٨ م/ث.", "عسير: الرطوبة ١٣٨٪ من معدلها، وطاقة عدم الاستقرار نحو ١٣٧٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشرق بنحو ٥ م/ث.", "جازان: الرطوبة ١٣٨٪ من معدلها، وطاقة عدم الاستقرار نحو ٦٣٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشرق بنحو ٣ م/ث.", "الحدود الشمالية: تبريد علوي من أخدود متعمق، والرطوبة ١١٨٪ من معدلها.", "الموجة العلوية الباردة", "تظهر ملامح موجة علوية باردة: أخدود متوسط العمق فوق المملكة، يتعمق في مركزه، ويصل طرفه الضحل إلى الحجاز.", "السبب: أخدود عند ٥٠٠ هكتوباسكال مركزه فوق شرق تركيا وشمال العراق بعمق ٨٫٣ ديكامتر، يمتد محوره جنوبًا فوق الحدود الشمالية، والجوف، وتبوك، والمدينة المنورة حتى نحو ٢٥ شمالًا؛ وأعمق جزء منه داخل المملكة ٥٫٥ ديكامتر دون المعدل عند ٣٢ شمالًا، و٢٫١ فقط عند طرفه الجنوبي.", "وغدًا يتعمق مركزه (٨٫٣ ثم ١٠ ديكامتر)، ويمتد محوره فوق الشرقية، والرياض، ومكة المكرمة، والمدينة المنورة حتى نحو ٢٣ شمالًا، بعمق ٤٫٣ ديكامتر فوق المملكة.", "العلامات: هبط سطح ٥٠٠ هكتوباسكال خلال يوم نحو ١٦ مترًا فوق مكة المكرمة، و١٤ مترًا فوق المدينة المنورة، و١١ مترًا فوق الباحة، وحرارة ٥٠٠ فوق الحجاز وغرب المملكة ‎−٨٫٣°، أبرد من معدلها بـ١°، وحرارة ٥٠٠ فوق شمال المملكة ‎−١٣°، أبرد من معدلها بـ١٫٢°.", "التوجيه: تؤخذ أماكن المطر واتساعه من تشغيل نموذجنا بالأوروبي (يكتمل قرابة السادسة صباحًا)، وتُتابع مواضع العواصف الرعدية وشدتها على خريطة تشغيل نموذجنا بالأمريكي.", "هذه القراءة من المكونات لا من مطر النماذج: الرطوبة، والتقاء الرياح على التضاريس، والتبريد العلوي، وطاقة عدم الاستقرار، ورياح الطبقات المتوسطة. ودرجة كل منطقة من توافقها، ولا تُعطى «قوية» في يوم ضعيف الصورة الكبرى، والمنطقة بلا التقاء رياح زخاتها محتملة فقط. ومطر نموذجنا على الخريطة."], "inputs": {"collide": {"day": "2026-11-18", "hours": 7, "zones": [{"lat": 28.75, "lon": 43.0, "region": "الحدود الشمالية", "regions": ["الحدود الشمالية"], "dir": "غرب", "place": "لينة", "km": 75, "a": null, "b": null, "winds": ["جنوبية غربية", "جنوبية"], "oro": false, "peak_h": "2026-11-18T14:00Z", "c": 3.2, "pw": 20, "cells": 12}]}, "plains": {"day": "2026-11-18", "cycle": "2026111712", "rows": [{"key": "jazan", "name": "سهول تهامة جازان (صبيا وأبو عريش وصامطة)", "region": "جازان", "pw": 37.9, "pct": 138, "td": 20.1, "t2": 31.8, "cape_plain": 1548, "cape_mtn": 44, "rh700_mtn": 55, "rain_mtn_gfs": 0.1, "rain_plain_gfs": 1.1, "steer": 4.1, "steer_u": 4.0, "steer_v": 0.8, "u700": -0.5, "u10": 4.7, "u850": -0.4, "flags": {"moist": true, "humid": true, "unstable": true, "mountain": false, "steer": true, "inflow": true}, "gate": false, "score": 5, "box": [16.5, 17.9, 42.5, 43.1], "mbox": [16.5, 17.9, 43.0, 43.6]}, {"key": "asir", "name": "تهامة عسير (محايل والدرب والبرك)", "region": "عسير", "pw": 38.1, "pct": 138, "td"