ة عدم الاستقرار نحو ١٢٣٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشمال الشرقي بنحو ١٢ م/ث.", "عسير: تبريد علوي من أخدود ضحل، والرطوبة ٢٢٠٪ من معدلها، وطاقة عدم الاستقرار نحو ١١٤٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشمال الشرقي بنحو ٨ م/ث.", "جازان: تبريد علوي من أخدود ضحل، والرطوبة ٢٢٠٪ من معدلها، وطاقة عدم الاستقرار نحو ١١٠٠ جول/كغ، والرياح في الطبقات المتوسطة تدفع الخلايا نحو الشرق بنحو ٥ م/ث.", "الرياض: تبريد علوي من أخدود ضحل، والرطوبة ١٧٣٪ من معدلها.", "الشرقية: تبريد علوي من أخدود ضحل، والرطوبة ١٨٥٪ من معدلها.", "نجران: تبريد علوي من أخدود ضحل، والرطوبة ٢٢٠٪ من معدلها.", "الموجة العلوية الباردة", "تظهر ملامح موجة علوية باردة: أخدود متوسط العمق فوق المملكة، يضعف في مركزه، ويصل طرفه الضحل إلى الحجاز.", "السبب: أخدود عند ٥٠٠ هكتوباسكال مركزه فوق شرق تركيا وشمال العراق بعمق ٨٫٤ ديكامتر، يمتد محوره جنوبًا فوق الحدود الشمالية، وحائل، والمدينة المنورة، ومكة المكرمة حتى نحو ٢٣ شمالًا؛ وأعمق جزء منه داخل المملكة ٤٫٨ ديكامتر دون المعدل عند ٣٠ شمالًا، و٢٫٦ فقط عند طرفه الجنوبي.", "وغدًا يضعف مركزه (٨٫٤ ثم ٥٫٧ ديكامتر)، ويمتد محوره فوق الحدود الشمالية، والشرقية، والرياض، والقصيم، بعمق ٣ ديكامتر فوق المملكة.", "العلامات: هبط سطح ٥٠٠ هكتوباسكال خلال يوم نحو ٢٦ مترًا فوق مكة المكرمة، و١٨ مترًا فوق الباحة، و١٩ مترًا فوق عسير، و١٦ مترًا فوق جازان، وحرارة ٥٠٠ فوق الحجاز وغرب المملكة ‎−٩°، أبرد من معدلها بـ٢٫١°، وحرارة ٥٠٠ فوق جنوب غرب المملكة ‎−٦٫٦°، أبرد من معدلها بـ١٫٣°، وحرارة ٥٠٠ فوق وسط المملكة ‎−١٠°، أبرد من معدلها بـ٢٫٥°، وحرارة ٥٠٠ فوق شرق المملكة ‎−١٠°، أبرد من معدلها بـ٢٫٢°، وحرارة ٥٠٠ فوق شمال المملكة ‎−١٤°، أبرد من معدلها بـ٢٫٥°.", "ولا يُتوقع مطر تحت الموجة على تبوك، والجوف، والحدود الشمالية، وحائل، لجفاف الهواء أو غياب الرفع، فأثرها هناك برودة ورياح.", "التوجيه: تؤخذ أماكن المطر واتساعه من تشغيل نموذجنا بالأوروبي (يكتمل قرابة السادسة صباحًا)، وتُتابع مواضع العواصف الرعدية وشدتها على خريطة تشغيل نموذجنا بالأمريكي.", "هذه القراءة من المكونات لا من مطر النماذج: الرطوبة، والتقاء الرياح على التضاريس، والتبريد العلوي، وطاقة عدم الاستقرار، ورياح الطبقات المتوسطة. ودرجة كل منطقة من توافقها، ولا تُعطى «قوية» في يوم ضعيف الصورة الكبرى، والمنطقة بلا التقاء رياح زخاتها محتملة فقط. ومطر نموذجنا على الخريطة."], "inputs": {"collide": {"day": "2026-11-11", "hours": 7, "zones": [{"lat": 17.5, "lon": 44.0, "region": "عسير", "regions": ["عسير", "نجران"], "dir": "غرب", "place": "نجران", "km": 14, "a": "بيشة", "b": "نجران", "winds": ["جنوبية غربية", "جنوبية شرقية"], "oro": false, "peak_h": "2026-11-11T14:00Z", "c": 6.7, "pw": 22, "cells": 31}, {"lat": 22.5, "lon": 44.25, "region": "الرياض", "regions": ["الرياض"], "dir": "جنوب غرب", "place": "الرين", "km": 176, "a": null, "b": null, "winds": ["جنوبية شرقية"], "oro": false, "peak_h": "2026-11-11T08:00Z", "c": 5.4, "pw": 24, "cells": 11}, {"lat": 24.25, "lon": 49.75, "region": "الشرقية", "regions": ["الشرقية"], "dir": "جنوب غرب", "place": "سلوى", "km": 120, "a": null, "b": null, "winds": ["شمالية", "شمالية شرقية"], "oro": false, "peak_h": "2026-11-11T13:00Z", "c": 2.4, "pw": 40, "cells": 11}, {"lat": 20.75, "lon": 41.75, "region": "مكة المكرمة", "regions": ["مكة المكرمة"], "dir": "جنوب", "place": "تربة", "km": 53, "a": null, "b": null, "winds": ["شمالية غربية", "جنوبية غربية"], "oro": false, "peak_h": "2026-11-11T13:00Z", "c": 5.0, "pw": 30, "cells": 4}]}, "plains": {"day": "2026-11-11", "cycle": "2026111012", "rows": [{"key": "jazan", "name": "سهول تهامة جازان (صبيا وأبو عريش وصامطة)", "region": "جازان", "pw": 53.0, "pct": 220, "td": 21.1, "t2": 31.1, "cape_plain": 1499, "cape_mtn": 666, "rh700_mtn": 79, "rain_mtn_gfs": 2.5, "rain_plain_gfs": 0.4, "steer": 4.8, "steer_u": 4.6, "steer_v": 1.4, "u700": 2.0, "u10": 5.5, "u850": 0.7, "flags": {"moist": true, "humid": true, "unstable": true, "mountain": true, "steer": true, "inflow": true}, "gate": true, "score": 6, "box": [16.5, 17.9, 42.5, 43.1], "mbox": [16.5, 17.9, 43.0, 43.6]}, {"key": "asir", "name": "تهامة عسير (محايل والدرب والبرك)", "region": "عسير", "pw": 49.1, "pct": 220, "td": 19.8, "t2": 30.5, "cape_plain":